# Скопируйте в .env и подставьте свои значения. Файл .env в Git не попадает.

# dev | test | prod
APP_ENV=dev

# postgresql+psycopg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL=postgresql+psycopg://sklad:change-me@localhost:5432/sklad

# Случайная строка не короче 16 символов, ей подписываются cookie сессии
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Если задан, журнал пишется ещё и в файл
LOG_FILE=logs/app.log

# Контейнерное окружение (make up, docs/docker.md): пароли PostgreSQL в контейнере db.
# Не путать с паролем локального PostgreSQL выше. make setup заполняет их случайными значениями.
POSTGRES_PASSWORD=change-me-postgres
SKLAD_DB_PASSWORD=change-me-sklad
