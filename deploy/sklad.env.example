# Настройки приложения на сервере: /etc/sklad/sklad.env (владелец root, группа sklad, права 640).
# Файл создаёт app-setup.sh из образца deploy/sklad.env.example: подставляет пароль БД
# и генерирует SECRET_KEY. Рабочий файл с паролями в репозиторий не попадает.

APP_ENV=prod
DATABASE_URL=postgresql+psycopg://sklad:DB_PASSWORD@192.168.56.11:5432/sklad?connect_timeout=5
SECRET_KEY=SECRET_KEY
LOG_LEVEL=INFO
